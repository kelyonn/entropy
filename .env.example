# Copy to .env for local Compose overrides. Do not commit real secrets.

# Port map (do not confuse these):
#   Host 3000  = frontend nginx
#   Host 8082  = Session Manager (maps to container 8080)
#   Compose-internal: Airlock 8081, AI Explainer 8082, eBPF 8083
# Redis / Postgres / MinIO are not published on the host.
# DATABASE_URL, Redis, and MinIO URLs are hardcoded in docker-compose.yml;
# change them there if you need different connection strings.

# --- Compose / Session Manager ---
MAX_SESSIONS=100
# IDLE_TIMEOUT_SECONDS=
# MAX_SESSION_SECONDS=
# SESSION_SWEEP_SECONDS=30
AWS_REGION=us-east-1

# OIDC / Keycloak (leave empty for guest-only local mode)
# OIDC_ISSUER_URL=
# OIDC_JWKS_URL=
# OIDC_CLIENT_ID=

# eBPF: simulator on macOS/local; false + privileged on Linux (see docs/linux-ebpf.md)
EBPF_SIMULATOR_MODE=true
# EBPF_PRIVILEGED=false

# Ollama (AI Explainer)
# OLLAMA_MODEL=llama3

# Frontend build args (Compose nginx UI). Leave empty for same-origin.
# VITE_API_URL=
# VITE_WS_URL=
#
# OIDC build args (used by keycloak-js in the frontend).
# VITE_OIDC_URL=http://127.0.0.1:8087
# VITE_OIDC_REALM=entropy
# VITE_OIDC_CLIENT_ID=entropy-app

# --- Local Vite (npm run dev) ---
# Session Manager is published on host 8082 by Compose.
# VITE_SESSION_MANAGER_URL=http://127.0.0.1:8082
# VITE_SESSION_MANAGER_WS_URL=ws://127.0.0.1:8082

# --- Public VM (Cloudflare Tunnel; see docs/vm-deploy.md) ---
# CLOUDFLARE_TUNNEL_TOKEN=
# After public hostnames exist, rebuild frontend with matching VITE_OIDC_URL.
